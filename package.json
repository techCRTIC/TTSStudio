{
  "name": "tts-studio",
  "version": "0.1.4",
  "private": true,
  "description": "Genera voz clonada desde texto, en tu propia máquina.",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "build": "npm run build --prefix web",
    "test": "npm test --prefix web",
    "lint": "npm run lint --prefix web",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win --publish never"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "cl.crtic.ttsstudio",
    "productName": "TTS Studio",
    "copyright": "Copyright (c) 2026 CRTIC",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/recursos"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/recursos/icon.ico",
      "scripts/engine.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/build/app",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "desktop/recursos/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "desktop/recursos/icon.ico",
      "uninstallerIcon": "desktop/recursos/icon.ico",
      "installerHeaderIcon": "desktop/recursos/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
