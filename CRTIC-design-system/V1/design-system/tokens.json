{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "CRTIC clean design tokens — machine source of truth. Mirrors tokens/primitives.css.",
  "color": {
    "snow": { "value": "#F5F5F7", "comment": "main surface" },
    "white": { "value": "#FFFFFF" },
    "card": { "value": "#FCFCFD", "comment": "surface, a hair off pure white" },
    "ink": { "value": "#1D1D1F", "comment": "soft black text/logo, never #000" },
    "ink-2": { "value": "#6E6E73", "comment": "secondary text" },
    "hairline": { "value": "#D2D2D7", "comment": "borders/rules" },
    "orange": { "value": "#FA4515", "comment": "the only accent" },
    "orange-hover": { "value": "#E23C0F" },
    "scrim": { "value": "#0C0C0E", "comment": "dark stage behind media" }
  },
  "font": {
    "sans": { "value": "Geist Variable, ui-sans-serif, system-ui, -apple-system, sans-serif" },
    "mono": { "value": "Geist Mono Variable, ui-monospace, SFMono-Regular, monospace" }
  },
  "type": {
    "display": { "value": "clamp(2.5rem, 6.5vw, 5.25rem)" },
    "h2": { "value": "clamp(2rem, 4.5vw, 3.5rem)" },
    "h3": { "value": "clamp(1.35rem, 2.4vw, 1.75rem)" },
    "body-lg": { "value": "1.125rem" },
    "body": { "value": "1rem" },
    "sm": { "value": "0.875rem" },
    "eyebrow": { "value": "0.75rem" },
    "weight": { "regular": { "value": 400 }, "medium": { "value": 500 }, "semibold": { "value": 600 } },
    "tracking": { "display": { "value": "-0.03em" }, "tight": { "value": "-0.01em" }, "eyebrow": { "value": "0.14em" } },
    "leading": { "display": { "value": 0.98 }, "body": { "value": 1.6 } }
  },
  "space": {
    "1": { "value": "0.25rem" }, "2": { "value": "0.5rem" }, "3": { "value": "0.75rem" },
    "4": { "value": "1rem" }, "6": { "value": "1.5rem" }, "8": { "value": "2rem" },
    "10": { "value": "2.5rem" }, "16": { "value": "4rem" }, "24": { "value": "6rem" }, "32": { "value": "8rem" }
  },
  "radius": {
    "sm": { "value": "4px" }, "md": { "value": "12px" }, "lg": { "value": "16px" }, "full": { "value": "9999px" }
  },
  "shadow": {
    "card": { "value": "0 1px 2px rgba(0,0,0,0.04), 0 12px 40px -12px rgba(0,0,0,0.18)" },
    "hero": { "value": "0 1px 2px rgba(0,0,0,0.04), 0 24px 60px -20px rgba(0,0,0,0.22)" }
  },
  "motion": {
    "duration": {
      "press": { "value": "150ms" }, "ui": { "value": "200ms" }, "pop": { "value": "250ms" },
      "reveal": { "value": "700ms" }, "rise": { "value": "750ms" }
    },
    "easing": {
      "expo": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "comment": "default reveal" },
      "quart": { "value": "cubic-bezier(0.25, 1, 0.5, 1)", "comment": "default UI" },
      "in-expo": { "value": "cubic-bezier(0.7, 0, 0.84, 0)", "comment": "exits" }
    },
    "stagger": { "value": "50ms", "comment": "per item, keep 30–80ms" }
  },
  "z": { "nav": { "value": 50 } }
}
